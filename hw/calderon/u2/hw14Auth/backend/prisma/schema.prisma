generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  google_id     String   @unique
  name          String
  email         String   @unique
  profile_image String?  
  created_at    DateTime @default(now())

  @@map("users") 
}