{
  "name": "crud",
  "version": "1.0.0",
  "description": "Fábula Dental — CRUD Service",
  "license": "ISC",
  "author": "codexplorers",
  "type": "commonjs",
  "main": "dist/index.js",

  "scripts": {
    "build":        "tsc --project tsconfig.json",
    "start":        "node dist/index.js",
    "dev":          "ts-node src/index.ts",

    "sam:build":    "sam build --profile fabuladental-crud",
    "sam:deploy":   "sam deploy --profile fabuladental-crud --parameter-overrides \"DatabaseUrl=$DATABASE_URL\" \"CrudApiKey=$CRUD_API_KEY\"",
    "deploy":       "bun run build && bun run sam:build && bun run sam:deploy",

    "sam:delete":   "sam delete --stack-name fabuladental-crud --profile fabuladental-crud --no-prompts"
  },

  "dependencies": {
    "@codegenie/serverless-express": "^5.0.0",
    "@prisma/adapter-pg": "^6.0.0",
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.21.0"
  },

  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
