{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "front-end/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/front-end/(.*)",
      "dest": "/front-end/$1"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
