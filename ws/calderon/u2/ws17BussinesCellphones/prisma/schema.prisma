generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Cellphone {
  id              String   @id @default(uuid())
  name            String
  description     String
  price           Float
  releaseDate     DateTime
  model           String
  originCountry   String
  manufacturer    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}