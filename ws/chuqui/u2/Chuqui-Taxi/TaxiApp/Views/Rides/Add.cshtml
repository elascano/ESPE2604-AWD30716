@model TaxiApp.Models.Ride

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-dark text-white text-center">
                <h4><i class="fa-solid fa-file-invoice-dollar text-warning"></i> Registrar Viaje</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Add" method="post">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Origen</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
                            <input asp-for="Origin" class="form-control" placeholder="Ej. Sangolquí" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Destino</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-flag-checkered"></i></span>
                            <input asp-for="Destination" class="form-control" placeholder="Ej. Quito" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Costo del viaje ($)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-solid fa-dollar-sign"></i></span>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-taxi btn-lg">
                            <i class="fa-solid fa-save"></i> Guardar Carrera
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>