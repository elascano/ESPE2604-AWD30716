@model TaxiApp.Models.Ride

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6"> <div class="card shadow-lg border-0 rounded-3"> <div class="card-header bg-dark text-white text-center py-3">
                <h3 class="card-title mb-0 fw-bold">
                    <i class="fa-solid fa-file-invoice-dollar text-warning me-2"></i>
                    Nuevo Registro de Viaje
                </h3>
                <p class="text-muted-white mb-0 mt-1">Ingrese los detalles del recorrido y el costo.</p>
            </div>
            <div class="card-body p-5">
                <form asp-action="Add" method="post">
                    
                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <label class="form-label fw-bold">Punto de Origen</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fa-solid fa-location-dot text-danger"></i>
                                </span>
                                <input asp-for="Origin" class="form-control border-start-0 ps-0" placeholder="Ej. Terminal Quitumbe" required />
                            </div>
                            <div class="form-text text-muted">¿Dónde empezó la carrera?</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Punto de Destino</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fa-solid fa-flag-checkered text-success"></i>
                                </span>
                                <input asp-for="Destination" class="form-control border-start-0 ps-0" placeholder="Ej. Parque La Carolina" required />
                            </div>
                            <div class="form-text text-muted">¿Dónde terminó el viaje?</div>
                        </div>
                    </div>

                    <div class="row mb-4 justify-content-center">
                        <div class="col-md-8">
                            <div class="form-group text-center">
                                <label class="form-label fw-bold d-block">Costo Total del Viaje</label>
                                <div class="input-group input-group-lg shadow-sm"> <span class="input-group-text bg-warning border-0 text-dark fw-bold">
                                        <i class="fa-solid fa-dollar-sign"></i>
                                    </span>
                                    <input asp-for="Price" type="number" step="0.01" class="form-control border-0 text-success fw-bold text-center" placeholder="0.00" required />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row pt-2 justify-content-center">
                        <div class="col-sm-6 mb-3 mb-sm-0">
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-taxi btn-lg border-0 shadow-sm">
                                    <i class="fa-solid fa-save me-2"></i> Guardar Carrera
                                </button>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="d-grid gap-2">
                                <a asp-action="Summary" class="btn btn-outline-secondary btn-lg shadow-sm">
                                    <i class="fa-solid fa-list me-2"></i> Ver Historial
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
