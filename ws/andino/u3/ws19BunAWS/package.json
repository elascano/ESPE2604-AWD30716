{
  "name": "chickens",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot ./apps/api/app.ts",
    "debug": "bun run --inspect-wait --hot ./apps/api/app.ts",
    "db:generate": "drizzle-kit generate --config src/database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config src/database/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config src/database/drizzle.config.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.24",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  }
}
