{
    "name": "american-latin-class/backend",
    "description": "American Latin Class backend API with Slim and Eloquent ORM",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "illuminate/database": "^11.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\Controllers\\": "src/Controllers/",
            "App\\Middleware\\": "src/Middleware/",
            "App\\Services\\": "src/Services/",
            "App\\Support\\": "src/Support/",
            "App\\Models\\": "src/Models/"
        }
    },
    "scripts": {
        "start": "@php -S 127.0.0.1:8080 -t public",
        "start:production": "@php -S 0.0.0.0:${PORT:-8080} -t public",
        "lint": "@php tests/lint.php",
        "test": "@php tests/run.php",
        "check": ["@lint", "@test"]
    }
}
