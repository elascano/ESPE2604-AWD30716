@model Student

@{
    ViewData["Title"] = "Student Form";
}

<section id="student-form-app" class="workspace">
    <div class="page-heading">
        <span>Student entry</span>
        <h1>Register grades</h1>
    </div>

    <form asp-action="Create" method="post" class="student-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-grid">
            <label>
                First name
                <input asp-for="FirstName" autocomplete="given-name" required />
                <span asp-validation-for="FirstName"></span>
            </label>

            <label>
                Last name
                <input asp-for="LastName" autocomplete="family-name" required />
                <span asp-validation-for="LastName"></span>
            </label>

            <label>
                Email
                <input asp-for="Email" type="email" autocomplete="email" required />
                <span asp-validation-for="Email"></span>
            </label>

            <label>
                Phone number
                <input asp-for="PhoneNumber" autocomplete="tel" required />
                <span asp-validation-for="PhoneNumber"></span>
            </label>

            <label>
                Postal code
                <input asp-for="PostalCode" autocomplete="postal-code" required />
                <span asp-validation-for="PostalCode"></span>
            </label>

            <label>
                City
                <input asp-for="City" autocomplete="address-level2" required />
                <span asp-validation-for="City"></span>
            </label>

            <label class="wide">
                Course
                <input asp-for="CourseName" required />
                <span asp-validation-for="CourseName"></span>
            </label>

            <label>
                Unit 1 grade
                <input asp-for="UnitOneGrade" type="number" min="0" max="20" step="0.01" v-model.number="unitOne" required />
                <span asp-validation-for="UnitOneGrade"></span>
            </label>

            <label>
                Unit 2 grade
                <input asp-for="UnitTwoGrade" type="number" min="0" max="20" step="0.01" v-model.number="unitTwo" required />
                <span asp-validation-for="UnitTwoGrade"></span>
            </label>

            <label>
                Unit 3 grade
                <input asp-for="UnitThreeGrade" type="number" min="0" max="20" step="0.01" v-model.number="unitThree" required />
                <span asp-validation-for="UnitThreeGrade"></span>
            </label>
        </div>

        <aside class="grade-preview" aria-live="polite">
            <div>
                <span>Student mean</span>
                <strong>{{ mean }}</strong>
            </div>
            <div>
                <span>Status</span>
                <strong :class="passed ? 'pass' : 'fail'">{{ passed ? 'Pass' : 'Not pass' }}</strong>
            </div>
        </aside>

        <button type="submit">Save student</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        Vue.createApp({
            data() {
                return {
                    unitOne: Number('@Model.UnitOneGrade'),
                    unitTwo: Number('@Model.UnitTwoGrade'),
                    unitThree: Number('@Model.UnitThreeGrade')
                };
            },
            computed: {
                mean() {
                    return ((this.unitOne + this.unitTwo + this.unitThree) / 3).toFixed(2);
                },
                passed() {
                    return Number(this.mean) >= 14;
                }
            }
        }).mount('#student-form-app');
    </script>
}
