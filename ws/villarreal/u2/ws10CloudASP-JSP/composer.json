{
    "name": "app/productos-mvc",
    "description": "Monolithic PHP product management system with MongoDB",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "mongodb/mongodb": "^1.0",
        "ext-mongodb": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 0.0.0.0:8080 -t public"
        ]
    }
}
