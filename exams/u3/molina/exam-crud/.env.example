PORT=3000

# Cadena con pooling activado (-pooler en el host). Se usa durante la ejecución.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Cadena directa (sin -pooler). Prisma la usa para aplicar el esquema con db push.
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-HOST.REGION.aws.neon.tech/neondb?sslmode=require
