# Copy this file to .env and edit it for the object assigned in the exam.

# Server
PORT=3000
ENABLE_CORS=true
# Use all for local development, read for GET instance, write for POST/PUT/DELETE instance.
INSTANCE_ROLE=all

# MongoDB Atlas or local MongoDB.
# Example Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/storeSoccker?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb://127.0.0.1:27017/exam_u2_goalkeeper_gloves

# Object configuration.
# Change these values when the teacher gives you the object.
OBJECT_NAME=glove
OBJECT_PLURAL=gloves
COLLECTION_NAME="GoalKeeper Gloves"
API_BASE_PATH=/api/gloves

# Main identifier and price fields.
ID_FIELD=serialNumber
PRICE_FIELD=price

# Business rule options:
# none | brand_size_range
BUSINESS_RULE=brand_size_range
PREMIUM_BRANDS=Adidas,Nike,Puma,Reusch,Uhlsport,Elite

# true = DELETE marks deleted:true. false = DELETE removes from MongoDB.
SOFT_DELETE=true
