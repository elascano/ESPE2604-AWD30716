{
  "name": "crud",
  "version": "1.0.0",
  "description": "CRUD service - handles database operations for soundmixers via Supabase/PostgreSQL",
  "license": "ISC",
  "author": "codexplorers",
  "type": "commonjs",
  "main": "dist/handler.js",
  "scripts": {
    "build": "tsc",
    "start": "IS_LOCAL=true node dist/handler.js",
    "dev": "IS_LOCAL=true ts-node src/handler.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
