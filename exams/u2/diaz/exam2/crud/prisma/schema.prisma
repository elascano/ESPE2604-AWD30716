// This is your Prisma schema file for Prisma v7+
// The connection URL is configured in prisma.config.ts (not here)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model supplies {
  id           Int      @id @default(autoincrement())
  serialNumber String   @unique
  brand        String
  model        String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  status       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
